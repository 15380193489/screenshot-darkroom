{
  "name": "screenshot-darkroom",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "截图冲洗室 — 离线截图整理托盘工具",
  "scripts": {
    "build": "tauri build --ci",
    "build:portable": "tauri build --no-bundle --ci",
    "dev": "tauri dev",
